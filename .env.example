# Server
PORT=3000
NODE_ENV=development

# Network: "testnet" (default) or "mainnet"
STELLAR_NETWORK=testnet

# RPC endpoint.
# Optional on testnet (defaults to the public SDF testnet RPC).
# REQUIRED on mainnet: use an RPC provider or your own node.
STELLAR_RPC_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Comma-separated list of allowed CORS origins. Empty = allow all.
CORS_ORIGINS=
